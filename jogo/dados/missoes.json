{
  "quem": {
    "id": "seu-tonho",
    "nome": "Seu Tonho",
    "descricao": "O vizinho. Ensina cada coisa nova, dá as primeiras ferramentas e faz pedidos."
  },
  "eventos": {
    "nota": "Eventos que a lógica emite e que missões e conquistas escutam. Cada evento leva \"n\" (quantidade, 1 se faltar) e os campos do filtro (no filtro, uma lista vale por \"qualquer um destes\"). Ferramenta que a missão pede vem na recompensa da missão anterior. Missão com \"valeJaTer\" (comprar ou construir uma coisa) conclui na hora se o jogador já tem o que ela pede: ninguém fica preso por ter se adiantado. \"soma\" troca o que se soma (por exemplo \"ouro\"); \"conta\": \"nivel\" usa o nível alcançado em vez de somar.",
    "lista": { "arou": "casa arada; com: \"boi\" quando é o boi que ara (com a enxada o campo não vem)", "plantou": "semente ou muda no chão; item (a semente ou a muda), cultura ou arvore", "encheu": "regador cheio no poço; item, n", "regou": "casa regada; cultura", "colheu": "colheita de lavoura ou de árvore; item, n, cultura ou arvore", "vendeu": "venda na banca; item, n, ouro", "comprou": "compra com ouro; item, animal, lote ou construcao (o id do que foi comprado), n, ouro, classe (o tipo do item, ou \"animal\", \"lote\", \"construcao\"), familia (se for animal)", "limpou": "obstáculo tirado da terra; obstaculo: mato, toco, pedra ou mata", "guardou": "itens guardados no celeiro; n", "entregou": "pedido entregue; ouro, xp", "construiu": "construção pronta no terreno; construcao", "montou": "móvel posto no celeiro; construcao", "ampliou": "ampliação pronta; construcao, degrau", "produziu": "receita retirada da fila; item, n, onde (a construção)", "tratou": "cocho ou bebedouro abastecido; abrigo, parte: \"cocho\" ou \"bebedouro\"", "recolheu": "produto de animal recolhido; item, n, animal", "cavalgou": "montou no cavalo", "afagou": "afago no animal de estimação (mimo do dia)", "subiuDeNivel": "nível novo; nivel", "resgatou": "recompensa resgatada; classe: \"diaria\", \"conquista\" ou \"convite\"", "compartilhou": "link de compartilhar copiado" }
  },
  "vizinho": [
    { "id": "preparar-a-terra", "nivel": 1, "titulo": "Preparar a terra", "fala": "Que bom ter vizinhança nova! Eu sou o Tonho. A enxada, o regador e o cesto são presente meu. Este é o seu campo de plantação, do lado do poço. Pegue a enxada e are a primeira fileira: 6 casas. Segurando o dedo numa casa, vai a fileira toda.", "objetivo": { "evento": "arou", "n": 6 }, "recompensa": { "xp": 3 }, "ensina": "enxada" },
    { "id": "plantar-alface", "nivel": 1, "titulo": "Plantar", "fala": "Terra arada pede semente. Plante a alface na fileira: uma semente em cada casa.", "objetivo": { "evento": "plantou", "filtro": { "cultura": "alface" }, "n": 6 }, "recompensa": { "xp": 3 }, "ensina": "semear" },
    { "id": "agua-do-poco", "nivel": 1, "titulo": "Água do poço", "fala": "Sem água não nasce nada. Encha o regador no poço.", "objetivo": { "evento": "encheu", "n": 1 }, "recompensa": { "xp": 2 }, "ensina": "poço" },
    { "id": "regar", "nivel": 1, "titulo": "Regar", "fala": "Agora regue a fileira. O regador velho leva 4 regas: quando acabar, é só voltar ao poço.", "objetivo": { "evento": "regou", "n": 6 }, "recompensa": { "xp": 3 }, "ensina": "regador" },
    { "id": "primeira-colheita", "nivel": 1, "titulo": "Primeira colheita", "fala": "Alface é ligeira: em um minuto está pronta. Colha a fileira toda: vai tudo para o cesto. A terra colhida continua campo, é só arar de novo para plantar.", "objetivo": { "evento": "colheu", "filtro": { "item": "alface" }, "n": 6 }, "recompensa": { "xp": 4, "ouro": 10 }, "ensina": "colher e cesto" },
    { "id": "vender-na-banca", "nivel": 1, "titulo": "Vender na banca", "fala": "A banca da porteira compra tudo, sempre, pelo preço de tabela. Leve as alfaces lá.", "objetivo": { "evento": "vendeu", "n": 6 }, "recompensa": { "xp": 4, "ouro": 15 }, "ensina": "banca" },
    { "id": "comprar-sementes", "nivel": 1, "titulo": "Comprar sementes", "fala": "Com o ouro da venda se compra mais semente. Abra a loja e compre sementes.", "objetivo": { "evento": "comprou", "filtro": { "classe": "semente" }, "n": 6 }, "recompensa": { "xp": 4, "itens": { "semente-alface": 6 } }, "ensina": "loja" },
    { "id": "plantar-milho", "nivel": 2, "titulo": "Milho", "fala": "Subiu de nível, liberou o milho! Demora 3 minutos e dá duas espigas por pé. Colha 8 espigas.", "objetivo": { "evento": "colheu", "filtro": { "item": "milho" }, "n": 8 }, "recompensa": { "xp": 8, "ouro": 30, "itens": { "foice-velha": 1 } }, "ensina": "culturas novas a cada nível" },
    { "id": "rocar-o-mato", "nivel": 2, "titulo": "Roçar o mato", "fala": "Esse mato na beirada atrapalha. A foice que eu te dei está no suporte do celeiro: roce 6 casas. O mato dá fibra, que serve para amarrar e trançar.", "objetivo": { "evento": "limpou", "filtro": { "obstaculo": "mato" }, "n": 6 }, "recompensa": { "xp": 8, "ouro": 20 }, "ensina": "limpar terra e trocar de ferramenta" },
    { "id": "regador-novo", "nivel": 3, "titulo": "A primeira melhoria", "fala": "Cansou de ir ao poço? O regador de lata leva o dobro de água. Compre um na loja.", "objetivo": { "evento": "comprou", "filtro": { "item": "regador-de-lata" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 10, "ouro": 20 }, "ensina": "ferramenta melhor" },
    { "id": "primeiro-pedido", "nivel": 3, "titulo": "O quadro de pedidos", "fala": "Preguei um quadro ao lado da banca. Pedido paga mais que a banca e ainda dá experiência. Entregue um.", "objetivo": { "evento": "entregou", "n": 1 }, "recompensa": { "xp": 12, "ouro": 30 }, "ensina": "pedidos" },
    { "id": "guardar-no-celeiro", "nivel": 3, "titulo": "Guardar no celeiro", "fala": "Nem tudo se vende na hora. Guarde 10 coisas no celeiro: é só tocar nele com o cesto cheio.", "objetivo": { "evento": "guardou", "n": 10 }, "recompensa": { "xp": 10, "itens": { "machado-velho": 1 } }, "ensina": "celeiro" },
    { "id": "lenha", "nivel": 3, "titulo": "Tocos", "fala": "Toco no meio do caminho vira madeira. Leve o machado que eu te dei e tire 3 tocos.", "objetivo": { "evento": "limpou", "filtro": { "obstaculo": "toco" }, "n": 3 }, "recompensa": { "xp": 12, "ouro": 30 }, "ensina": "machado e madeira" },
    { "id": "bancada-de-carpintaria", "nivel": 4, "titulo": "A bancada de carpintaria", "fala": "Com madeira dá para montar a bancada. É nela que se constrói tudo na fazenda. Compre na loja e escolha o lugar.", "objetivo": { "evento": "construiu", "filtro": { "construcao": "bancada-de-carpintaria" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 20, "itens": { "prego": 30 } }, "ensina": "construir e escolher o lugar" },
    { "id": "tabuas", "nivel": 4, "titulo": "Tábuas", "fala": "Na bancada, duas madeiras viram uma tábua. Serre 4.", "objetivo": { "evento": "produziu", "filtro": { "item": "tabua" }, "n": 4 }, "recompensa": { "xp": 15, "ouro": 40, "itens": { "picareta-velha": 1 } }, "ensina": "receitas e fila" },
    { "id": "pedras", "nivel": 4, "titulo": "Pedras", "fala": "Pedra também é material. Leve a picareta que eu te dei e quebre 3.", "objetivo": { "evento": "limpou", "filtro": { "obstaculo": "pedra" }, "n": 3 }, "recompensa": { "xp": 15, "itens": { "tabua": 4 } }, "ensina": "picareta e pedra" },
    { "id": "galinheiro", "nivel": 5, "titulo": "O galinheiro", "fala": "Fazenda sem galinha não é fazenda. Construa o galinheiro na bancada: tábua, fibra e prego.", "objetivo": { "evento": "construiu", "filtro": { "construcao": "galinheiro" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 30, "itens": { "milho": 12 } }, "ensina": "abrigo antes do animal" },
    { "id": "galinhas", "nivel": 5, "titulo": "As galinhas", "fala": "A vaga é do galinheiro; a galinha se compra. Compre 2.", "objetivo": { "evento": "comprou", "filtro": { "animal": "galinha" }, "n": 2 }, "valeJaTer": true, "recompensa": { "xp": 20 }, "ensina": "comprar animal" },
    { "id": "trato", "nivel": 5, "titulo": "O trato", "fala": "Bicho bem tratado produz o dobro. Ponha milho no comedouro e água no bebedouro.", "objetivo": { "evento": "tratou", "filtro": { "abrigo": "galinheiro" }, "n": 2 }, "recompensa": { "xp": 15, "itens": { "caixa-de-ovos": 1 } }, "ensina": "comida e água" },
    { "id": "ovos", "nivel": 5, "titulo": "Os ovos", "fala": "Ovo se recolhe com a caixa. Leve a que eu te dei e recolha 4 ovos.", "objetivo": { "evento": "recolheu", "filtro": { "item": "ovo" }, "n": 4 }, "recompensa": { "xp": 25, "ouro": 60 }, "ensina": "ferramenta de trato" },
    { "id": "prateleira", "nivel": 5, "titulo": "Prateleiras", "fala": "O celeiro guarda o que cabe nas prateleiras. Entre nele e monte mais uma.", "objetivo": { "evento": "montou", "filtro": { "construcao": "prateleira-simples" }, "n": 1 }, "recompensa": { "xp": 25, "itens": { "tabua": 4, "prego": 8 } }, "ensina": "celeiro por dentro" },
    { "id": "terra-nova", "nivel": 5, "titulo": "Terra nova", "fala": "O Pasto do Fundo está à venda. Terra nova vem com mato, pedra e toco, mas é mais espaço e mais material.", "objetivo": { "evento": "comprou", "filtro": { "lote": "lote-1" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 40, "ouro": 100 }, "ensina": "comprar lote" },
    { "id": "embalar", "nivel": 6, "titulo": "A dúzia", "fala": "Ovo solto vale menos. Monte a bancada de embalar e feche uma dúzia: 12 ovos e uma cartela.", "objetivo": { "evento": "produziu", "filtro": { "item": "duzia-de-ovos" }, "n": 1 }, "recompensa": { "xp": 40, "itens": { "cartela-vazia": 5 } }, "ensina": "embalar vale mais" },
    { "id": "bananal", "nivel": 7, "titulo": "Bananeiras", "fala": "Árvore é paciência: a muda demora, mas depois dá fruta para sempre. Plante 2 mudas de bananeira.", "objetivo": { "evento": "plantou", "filtro": { "item": "muda-bananeira" }, "n": 2 }, "recompensa": { "xp": 40, "ouro": 100 }, "ensina": "árvores" },
    { "id": "moinho", "nivel": 7, "titulo": "O moinho", "fala": "O moinho transforma milho em fubá e em ração. Construa um e faça 2 fubás.", "objetivo": { "evento": "produziu", "filtro": { "item": "fuba" }, "n": 2 }, "recompensa": { "xp": 50, "ouro": 150 }, "ensina": "indústria" },
    { "id": "cozinha", "nivel": 8, "titulo": "A cozinha", "fala": "Fubá e ovo dão bolo. Construa a cozinha e asse um bolo de fubá.", "objetivo": { "evento": "produziu", "filtro": { "item": "bolo-de-fuba" }, "n": 1 }, "recompensa": { "xp": 60, "ouro": 200 }, "ensina": "cadeia de produção" },
    { "id": "companheiro", "nivel": 8, "titulo": "Um companheiro", "fala": "Todo terreiro tem um bicho de estimação. Adote um gato ou um cachorro. Um afago por dia e ele traz um mimo.", "objetivo": { "evento": "comprou", "filtro": { "familia": "estimacao" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 40, "cash": 2 }, "ensina": "animais de estimação" },
    { "id": "curral", "nivel": 9, "titulo": "O curral", "fala": "Vaca só vem com curral pronto: cerca, cocho e bebedouro. Construa o curral.", "objetivo": { "evento": "construiu", "filtro": { "construcao": "curral" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 80, "itens": { "racao": 6, "balde": 1 } }, "ensina": "construção grande" },
    { "id": "leite", "nivel": 9, "titulo": "O leite", "fala": "Compre uma vaca, trate dela e ordenhe com o balde que eu te dei. Tire 2 baldes de leite.", "objetivo": { "evento": "recolheu", "filtro": { "item": "leite" }, "n": 2 }, "recompensa": { "xp": 80, "ouro": 300, "cash": 1 }, "ensina": "ordenha" },
    { "id": "queijo", "nivel": 11, "titulo": "O laticínio", "fala": "Leite parado azeda; no laticínio vira queijo. Faça um queijo minas.", "objetivo": { "evento": "produziu", "filtro": { "item": "queijo-minas" }, "n": 1 }, "recompensa": { "xp": 120, "ouro": 500 }, "ensina": "derivados" },
    { "id": "boi-de-arado", "nivel": 12, "titulo": "O boi de arado", "fala": "A lavoura cresceu e a enxada não dá conta. Faça o estábulo, compre o boi e o arado, e are 30 casas com ele.", "objetivo": { "evento": "arou", "filtro": { "com": "boi" }, "n": 30 }, "recompensa": { "xp": 150, "cash": 2 }, "ensina": "animal de trabalho" },
    { "id": "jumento", "nivel": 14, "titulo": "O jumento", "fala": "Para colheita grande, carroça. Abra a segunda baia do estábulo, compre a carroça e o jumento: ele vai atrás de você e leva 150 coisas.", "objetivo": { "evento": "comprou", "filtro": { "animal": "jumento" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 250, "ouro": 1500, "cash": 2 }, "ensina": "carga" },
    { "id": "ovelhas", "nivel": 15, "titulo": "As ovelhas", "fala": "Ovelha dá lã, e lã se tira com a tesoura de tosquia. Faça o aprisco e tosquie 3 vezes.", "objetivo": { "evento": "recolheu", "filtro": { "item": "la" }, "n": 3 }, "recompensa": { "xp": 250, "ouro": 1500 }, "ensina": "tosquia" },
    { "id": "barril", "nivel": 15, "titulo": "O barril", "fala": "Chega de ir ao poço a cada fileira. Ponha um barril de água na carroça: você enche o regador ali mesmo, no meio do campo.", "objetivo": { "evento": "comprou", "filtro": { "item": "barril-de-agua" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 250, "itens": { "racao": 8 } }, "ensina": "água no campo" },
    { "id": "cavalo", "nivel": 16, "titulo": "O cavalo", "fala": "A fazenda ficou grande para andar a pé. Com cavalo e sela você cruza o terreno num instante, sem cansar. Monte.", "objetivo": { "evento": "cavalgou", "n": 1 }, "recompensa": { "xp": 300, "cash": 2 }, "ensina": "montaria" },
    { "id": "irrigacao", "nivel": 18, "titulo": "Irrigação", "fala": "Campo grande pede irrigação fixa. Construa um aspersor na bancada: ele rega sozinho as 24 casas em volta.", "objetivo": { "evento": "construiu", "filtro": { "construcao": "aspersor" }, "n": 1 }, "valeJaTer": true, "recompensa": { "xp": 400, "cash": 3, "itens": { "pedra": 12, "prego": 20 } }, "ensina": "irrigação por setor" }
  ],
